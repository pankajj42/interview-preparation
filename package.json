  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "npm": ">=12"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve@latest out -l 3000",
