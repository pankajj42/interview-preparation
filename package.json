    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
